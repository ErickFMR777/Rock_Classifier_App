# Dependencies
__pycache__/
*.py[cod]
*$py.class
venv/
.env
*.egg-info/
dist/
build/

# Frontend
node_modules/
frontend/dist/
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Models (large files). rock_classifier.pt is deliberately tracked: the
# Dockerfile copies models/ into the image, so without it the deployed API
# serves an untrained head. The resume checkpoint stays out — it bundles
# optimiser state and is ~168 MB.
models/*.pt
!models/rock_classifier.pt
models/checkpoint_last.pt
models/checkpoint_last.tmp

# Dataset (images) — regenerate with backend/train/download_commons.py.
# The manifest is tracked: it records the licence and author of every image,
# which is what makes the CC-BY attribution obligations auditable.
dataset/*
!dataset/MANIFEST.json

# Database
*.db

# Temp files
*.tmp
/tmp/

# NOTE: frontend/package-lock.json is intentionally committed.
# Vercel needs it for reproducible installs.
