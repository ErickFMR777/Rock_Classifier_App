# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
# Enable only for local development. Hosted platforms inject $PORT, which wins.
API_RELOAD=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./data/database.db

# Model Paths
MODELS_DIR=../models

# ==================== CORS ====================
# Production frontend origin (no trailing slash).
FRONTEND_URL=https://your-app.vercel.app

# Optional: extra origins, comma-separated (custom domains).
ALLOWED_ORIGINS=

# Optional: regex for Vercel preview deployments, whose domain changes per push.
# Defaults to ^https://.*\.vercel\.app$ — narrow it to your project or set it
# empty to accept only the exact origins listed above.
VERCEL_PREVIEW_REGEX=
