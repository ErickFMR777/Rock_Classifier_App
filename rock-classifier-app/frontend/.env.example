# Base URL of the deployed FastAPI backend.
#
# Required in production (Vercel). Without it the Catalog and About sections
# still work, but the classifier shows a "backend not connected" notice.
#
# Both forms are accepted — the client normalises the /api suffix:
#   VITE_API_URL=https://rock-classifier-api.onrender.com
#   VITE_API_URL=https://rock-classifier-api.onrender.com/api
#
# Leave unset for local development: Vite proxies /api to http://localhost:8000.
VITE_API_URL=
